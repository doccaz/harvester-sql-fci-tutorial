# Copy to env.local and adjust. Lab values only: simple passwords on purpose (no clipboard on a VM console).
export KUBECONFIG="$HOME/.kube/harvester.yaml"   # your Harvester kubeconfig
NS=labs
DOMAIN=sqllab.local
NETBIOS=SQLLAB
IP_DC=192.168.100.170
IP_N1=192.168.100.171
IP_N2=192.168.100.172
IP_CLUSTER=192.168.100.173
IP_FCI=192.168.100.174
PREFIX=24
GATEWAY=192.168.100.1
LAN_NAD=default/local-network
ROOT_SC=harvester-2replicas
NODE_A=node-a            # Harvester node: runs dc1, n1 and the LIO target (use your real node names: kubectl get nodes)
NODE_B=node-b            # Harvester node: runs n2 and serves the ISOs on port 8099 (step 03)
ISO_NODE=$NODE_B
ADMIN_PASSWORD=Sqllab2026
SQLSVC_PASSWORD=Sqllab2026
DSRM_PASSWORD=Sqllab2026
# WIPE_LUNS=1               # step 08: clear any old data/signatures on the shared LUNs (destroys them; lab only)
